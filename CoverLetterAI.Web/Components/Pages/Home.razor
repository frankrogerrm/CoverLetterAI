IMPORTANT: IN THE RESULT, REMOVE ANY [t<counter>] AND [/t<counter>] THTA IS INSIDE OR BETWEEN OTHER [t<counter>] AND [/t<counter>].
IMPORTANT: EACH OF THESE TAGS SHOULD BE IN GERMAN

============JOB OFFER=================
";

        AIInstructionsCoverLetterTranslation=$@"Translate the following text to spanish keep the tags[t(number)] and [/t(number)]
============================================";

    }

    private string AIInstructionsCoverLetter { get; set; } = string.Empty;
    private string AIInstructionsCoverLetterTranslation { get; set; } = string.Empty;
    private string AIInstructionsCompanyInformation { get; set; } = string.Empty;
    private List<string> CompanyInformationFound { get; set; } = new();
    private List<string> CoverLetterInformationFound { get; set; } = new();
    private List<string> CoverLetterInformationTranslatedFound { get; set; } = new();



}
 *@