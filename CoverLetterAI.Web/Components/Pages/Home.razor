@* 

@rendermode InteractiveServer

@using System.Text.Json;
@using System.Text;
@using System.Text.RegularExpressions
@using CoverLetterAI.Service.Services
@using CoverLetterAI.Web.Components.Static

@inject ICoverLetterService coverLetterService
@inject IJSRuntime JS



<PageTitle>Home</PageTitle>


@if (IsLoading)
{
    <div class="overlay">
        <div class="spinner"></div>
    </div>
}


<EditForm Model="jobProfile" class="container p-4" OnSubmit="GenerateCoverLetter"
          FormName="coverLetterForm">

   <div class="mb-3">
        <label class="form-label">First Name:</label>
        <InputText @bind-Value="jobProfile.Firstname" class="form-control p-2" />
    </div>

    <div class="mb-3">
        <label class="form-label">Last Name:</label>
        <InputText @bind-Value="jobProfile.LastName" class="form-control p-2" />
    </div>

    <div class="mb-3">
        <label class="form-label">Profession:</label>
        <InputText @bind-Value="jobProfile.Profession" class="form-control p-2" />
    </div>

    <div class="mb-3">
        <label class="form-label">Birth Date:</label>
        <InputDate @bind-Value="jobProfile.BirthDate" class="form-control p-2" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email:</label>
        <InputText @bind-Value="jobProfile.Email" type="email" class="form-control p-2" />
    </div>

    <div class="mb-3">
        <label class="form-label">My Background:</label>
        <InputTextArea @bind-Value="jobProfile.MyBackground" type="email" class="form-control p-2" rows="10">
        </InputTextArea>
    </div>

    <div class="mb-3">
        <label class="form-label">Job Post URL:</label>
        <InputText typeof="text" @bind-value=@jobProfile.JobPostURL class="form-control p-2" />
    </div>

    <div class="mb-3">
        <label class="form-label">Company Request:</label>
        <InputText typeof="text" @bind-value=@jobProfile.JobPostURL class="form-control p-2" />
    </div>


    <button type="submit" class="btn btn-primary mt-3">Submit</button>
</EditForm>








<textarea @bind="RequestContent" rows="5" cols="150"></textarea>
<textarea @bind="CompanyInformation" rows="5" cols="150"></textarea>
<br />
<button @onclick="ProcessRequest">Click</button>


<div class="row">
    <div class="col-6" style=" border:double">
        @{
            foreach (var item in CoverLetterInformationFound)
            {
                <span>@(item)</span>
                <br />
            }
        }
    </div>
    <div class="col-6" style=" border:double">
        @{
            foreach (var item in CoverLetterInformationTranslatedFound)
            {
                <span>@(item)</span>
                <br />
            }
        }
    </div>
</div>

@code {

    private JobProfile jobProfile = new();

    protected override void OnInitialized()
    {
        jobProfile.MyBackground = Instructions.MyBackground;
    }


    public class JobProfile
    {
        public string LastName { get; set; } = string.Empty;
        public string Firstname { get; set; } = string.Empty;
        public string Profession { get; set; } = string.Empty;
        public DateTime? BirthDate { get; set; } = null;
        public string Email { get; set; } = string.Empty;
        public string MyBackground { get; set; } = string.Empty;
        public string JobPostURL { get; set; } = string.Empty;
    }



    public static async Task<string> GetPageTextContentAsync(string url)
    {
        using (HttpClient client = new HttpClient())
        {
            // Add a User-Agent header to mimic a browser

            client.DefaultRequestHeaders.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3");
            client.DefaultRequestHeaders.Add("Accept", "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8");
            client.DefaultRequestHeaders.Add("Accept-Language", "en-US,en;q=0.5");
            client.DefaultRequestHeaders.Add("Referer", url);


            HttpResponseMessage response = await client.GetAsync(url);
            response.EnsureSuccessStatusCode();
            string htmlContent = await response.Content.ReadAsStringAsync();
            return ExtractTextFromHtml(htmlContent);
        }
    }

    private static string ExtractTextFromHtml(string html)
    {
        var doc = new HtmlDocument();
        doc.LoadHtml(html);
        return doc.DocumentNode.InnerText;
    }


    private string newTabContent = string.Empty;


    public async Task GenerateCoverLetter()
    {

        newTabContent = await JS.InvokeAsync<string>("openNewTabAndGetContent", jobProfile.JobPostURL);
        Console.WriteLine(newTabContent); // Write content to the console

        // var t = await GetPageTextContentAsync(jobProfile.JobPostURL);
    }

    /// <summary>
    /// ///////////////////////////////////
    /// </summary>

    private bool IsLoading = false;
    private string RequestContent { get; set; } = "";
    private string CompanyInformation { get; set; } = "";

    private async Task ProcessRequest()
    {
        ShowLoader();
        BuildInstructionsCompanyInfo();
        await GetInfoCompany();
        BuildInstructionsCoverLetter();
        await GetInfoCoverLetter();
        HideLoader();
    }

    private void ShowLoader()
    {
        IsLoading = true;
        StateHasChanged();
    }

    private void HideLoader()
    {
        IsLoading = false;
        StateHasChanged();
    }

    private int GetTagsCounter(string text)
    {

        string pattern = @"\[/t(\d+)\]";
        MatchCollection matches = Regex.Matches(text, pattern);


        Match lastMatch = matches[matches.Count - 1];
        int lastNumber = int.Parse(lastMatch.Groups[1].Value);

        return lastNumber;
    }

    private async Task<string> PostGeminiRequest(string instructions)
    {
        string url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-04-17:generateContent?key=AIzaSyAgvxfKgeF5CsUXm8hQ4rPF0GNZ5_lz5To";
        var requestBody = new
        {
            contents = new[]
            {
                new
                {
                    parts = new[]
                    {
                        new { text = instructions }
                    }
                }
            }
        };

        using var client = new HttpClient();
        var json = JsonSerializer.Serialize(requestBody);
        var content = new StringContent(json, Encoding.UTF8, "application/json");

        HttpResponseMessage response = await client.PostAsync(url, content);
        string responseString = await response.Content.ReadAsStringAsync();

        Console.WriteLine(responseString);

        var counter = GetTagsCounter(responseString);

        string masterPatern = $@"\[t(\d+)\].*?\[\/t{counter}\]";

        Match masterMatch = Regex.Match(responseString, masterPatern);

        var result = masterMatch.Value;

        return result;

    }

    private List<string> ParseStringToList(string textToProcess, int counter)
    {
        string cleanPattern = @"\[t\d+\]|\[/t\d+\]";
        var result = new List<string>();
        for (int i = 1; i <= counter; i++)
        {
            var tag = $"t{i}";
            string extractedText = GetTextBetweenTagsRegex(textToProcess, $"[{tag}]", $"[/{tag}]");
            string cleanedText = Regex.Replace(extractedText, cleanPattern, string.Empty);
            cleanedText =  cleanedText.Replace($"\\n", " ");
            result.Add(cleanedText);
        }
        return result;
    }

    private async Task<(List<string>, List<string>)> ProcessGeminiCall(string instructions, bool includeTranslation = false)
    {
        var result = new List<string>();
        var textToUse = await PostGeminiRequest(instructions);
        var counter = GetTagsCounter(textToUse);

        result = ParseStringToList(textToUse, counter);


        // Check if any element in result is empty
        if (result.Any(string.IsNullOrEmpty))
        {
            // Recall ProcessGeminiCall if any element is empty
            return await ProcessGeminiCall(instructions);
        }

        // Return result if all elements are non-empty

        var resultTranslation = new List<string>();

        if (includeTranslation)
        {
            var translateInstrcutions = $"{AIInstructionsCoverLetterTranslation} {textToUse}";
            var textTranslated = await PostGeminiRequest(translateInstrcutions);
            resultTranslation = ParseStringToList(textTranslated, counter);
        }

        return (result, resultTranslation);


    }
    private async Task GetInfoCompany()
    {
        var instructions = $"{AIInstructionsCompanyInformation} {CompanyInformation}";
        CompanyInformationFound = (await ProcessGeminiCall(instructions)).Item1;

    }
    private async Task GetInfoCoverLetter()
    {
        var instructions = $"{AIInstructionsCoverLetter} {RequestContent}";
        var result = await ProcessGeminiCall(instructions, true);
        CoverLetterInformationFound = result.Item1;
        CoverLetterInformationTranslatedFound = result.Item2;
        coverLetterService.ProcessFile(CoverLetterInformationFound);

    }

    private static string GetTextBetweenTagsRegex(string input, string startTag, string endTag)
    {
        string pattern = Regex.Escape(startTag) + "(.*?)" + Regex.Escape(endTag);
        Match match = Regex.Match(input, pattern);

        if (match.Success)
        {
            return match.Groups[1].Value;
        }
        else
        {
            return string.Empty;
        }
    }

    private string GetGermanDateFormat(int addDays = 0)
    {
        return DateTime.Now.AddDays(addDays).ToString("dd. MMMM yyyy", new System.Globalization.CultureInfo("de-DE"));
    }

    private void BuildInstructionsCompanyInfo()
